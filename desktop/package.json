{
  "name": "janshare-desktop",
  "productName": "Janshare",
  "version": "1.1.0",
  "description": "Compartilhamento de tela P2P",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "icon": "electron scripts/build-icon.mjs",
    "native": "scripts\\build-native.cmd",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "electron-vite build && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
