{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webrtc-screen-share-mvp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}
